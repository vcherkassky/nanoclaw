      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 31
      },
      "panels": []
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Generation speed (tokens/s)",
      "description": "Native /api endpoints only; /v1 endpoints don't report timings",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (gen_ai_request_model) (rate(ollama_eval_tokens_per_second_sum[$__rate_interval])) / sum by (gen_ai_request_model) (rate(ollama_eval_tokens_per_second_count[$__rate_interval]))",
          "legendFormat": "{{gen_ai_request_model}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
